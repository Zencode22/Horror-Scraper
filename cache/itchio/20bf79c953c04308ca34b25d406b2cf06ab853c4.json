BCE;\npadding:16px;\nborder-radius:16px;\nwidth:85%;\nmargin:auto;\nmargin-top:16px;\nfont-size:1.1em;\ndisplay:block;\nbox-sizing:border-box;\n}\n\n.custom-rules li del{\ncolor:#FDEBCE;\nbackground:var(--dark-color);\nborder-radius:8px;\npadding:6px;\n}\n.custom-rules li p{\nmargin-top:16px;\nmargin-bottom:8px;\n} </style></head><body class=\"locale_en jam_layout_widget layout_widget responsive no_theme_toggle\" data-host=\"itch.io\" data-page_name=\"view_jam\"><div id=\"jam_layout_header_924696\" class=\"gray jam_layout_header_widget header_widget base_widget small_logo\"><a class=\"skip_to_main\" href=\"#maincontent\">Skip to main content</a><div class=\"primary_header\"><h1 title=\"itch.io - indie game hosting marketplace\" class=\"title\"><a title=\"itch.io - indie game hosting marketplace\" class=\"header_logo\" href=\"/\"><span class=\"visually_hidden\">itch.io</span><img src=\"https://static.itch.io/images/logo-black-new.svg\" class=\"full_logo\" width=\"775\" height=\"199\" alt=\"itch.io logo &amp; title\"/><img src=\"https://static.itch.io/images/itchio-textless-black.svg\" class=\"minimal_logo\" width=\"262\" height=\"235\" alt=\"itch.io logo\"/></a></h1><div class=\"header_buttons\"><a href=\"/games\" data-label=\"browse\" class=\"header_button browse_btn\">Browse Games</a><a href=\"/jams\" data-label=\"jams\" class=\"header_button jams_btn\">Game Jams</a><a href=\"/developers\" data-label=\"developers\" class=\"header_button developers_btn\"><span aria-hidden=\"true\" class=\"icon icon-upload\"></span>Upload Game</a><a href=\"/devlogs\" data-label=\"devlogs\" class=\"header_button devlogs_btn\">Developer Logs</a><a href=\"/community\" data-label=\"community.home\" class=\"header_button community.home_btn\">Community</a></div><form action=\"/search\" class=\"game_search\"><input name=\"q\" required=\"required\" class=\"search_input\" type=\"text\" placeholder=\"Search for games, jams, tags or creators\"/><button aria-label=\"Search\" class=\"submit_btn\"><svg stroke=\"currentColor\" stroke-linecap=\"round\" version=\"1.1\" role=\"img\" viewBox=\"0 0 24 24\" height=\"18\" class=\"svgicon icon_search\" aria-hidden fill=\"none\" width=\"18\" stroke-width=\"3\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg></button></form><div id=\"user_panel_7645045\" class=\"user_panel_widget base_widget\"><a href=\"/login\" data-register_action=\"header\" data-label=\"log_in\" class=\"panel_button\">Log in</a><a href=\"/register\" data-register_action=\"header\" data-label=\"register\" class=\"panel_button register_button\">Register</a></div></div><div class=\"header_dropdown\" data-target=\"browse\"><a href=\"/games/store\">Indie game store</a><a href=\"/games/free\">Free games</a><a href=\"/games/fun\">Fun games</a><a href=\"/games/tag-horror\">Horror games</a><div class=\"divider\"></div><a href=\"/tools\">Game development</a><a href=\"/game-assets\">Assets</a><a href=\"/comics\">Comics</a><div class=\"divider\"></div><a href=\"/sales\">Sales</a><a href=\"/bundles\">Bundles</a><div class=\"divider\"></div><a href=\"/jobs\">Jobs</a><div class=\"divider\"></div><a href=\"/tags\">Tags</a><a href=\"/game-development/engines\">Game Engines</a></div></div><div id=\"wrapper\" class=\"jam_page_wrap\"><div id=\"view_jam_220188\" class=\"view_jam_page view_jam_base_page page_widget base_widget view_jam_default before_start has_banner\"><div class=\"jam_banner_outer\"><img src=\"https://img.itch.zone/aW1nLzMwNDE3Mzc5LmdpZg==/original/G3c5im.gif\" class=\"jam_banner \"/></div><div class=\"jam_body\"><div id=\"jam_header_7044013\" class=\"jam_header_widget base_widget\"><div class=\"header_inner\"><div class=\"header_columns\"><div class=\"title_colum\"><h1 class=\"jam_title_header\"><a href=\"/jam/mini-jam-221-autumn\">Mini Jam 221: Autumn</a></h1><div class=\"jam_host_header\">Hosted by <a href=\"https://zahranworrell.itch.io\">ZahranW</a> · <a href=\"https://bsky.app/hashtag/minijam\">#minijam</a></div></div><div class=\"stats_container\"><div class=\"stat_box\"><div class=\"stat_value\">615</div><div class=\"stat_label\">Joined</div></div></div></div><div class=\"header_tabs\"><a href=\"/jam/mini-jam-221-autumn\" data-label=\"tab_view_jam\" class=\"header_tab active\">Overview</a><div class=\"tab_group\"><a href=\"/jam/mini-jam-221-autumn/community\" class=\"header_tab\">Community</a><span class=\"community_activity\">18</span></div></div></div></div><div class=\"submitter_outer\"><div id=\"jam_submitter_6713139\" class=\"jam_submitter_widget base_widget before_start\"><div class=\"date_data\">Submissions open from <span class=\"date_format\" data-format=\"MMMM Do YYYY [at] h:mm A\">2026-10-09 04:00:00</span> to <span class=\"date_format\" data-format=\"MMMM Do YYYY [at] h:mm A\">2026-10-12 04:00:00</span></div><div class=\"countdown\"><span class=\"countdown_label\">Starts in</span><div class=\"times\"><div data-name=\"years\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">years</div></div><div data-name=\"months\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">months</div></div><div data-name=\"days\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">days</div></div><div data-name=\"hours\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">hours</div></div><div data-name=\"minutes\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">minutes</div></div><div data-name=\"seconds\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">seconds</div></div></div></div><div class=\"state_action\"><button data-method=\"post\" class=\"button fat submitter_button join_jam_btn\" data-href=\"/jam/420578/join\">Join jam</button></div></div></div><div class=\"jam_content user_formatted\"><div class=\"custom-section custom-section-welcome\">\r\n<h2>What is Mini Jam?</h2>\r\n<p><a href=\"https://minijamofficial.com/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\"></a><a target=\"_blank\" href=\"https://minijamofficial.com/\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Mini jam</a>&nbsp;is a 72-hour-long game development jam that occurs every two weeks&nbsp;on&nbsp;Itch.io.<br> <br>The main focus of this jam is the&nbsp;mandatory limitation is&nbsp;announced as soon as the jam starts. The theme is provided early, so you can plan ahead. Just keep in mind that you may have to change your idea when the limitation is revealed.&nbsp; This jam&#x27;s theme is <strong><del>Autumn</del></strong>. Said&nbsp;theme is purely inspirational and it&#x27;s&nbsp;<em>not&nbsp;</em>required that you incorporate it into your game if you don&#x27;t want to. Feel free to interpret it however you want.</p><p>If you are unable to submit your game before the deadline, do not panic. There will be an announcement on the discord as well as a post in the jam community tab explaining the steps necessary to submit your game late.</p><p><a href=\"https://discord.gg/rTPBW9t\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Join the discord server</a> if you have any questions, want to be notified of any news,&nbsp;or just want to hang out with fellow jammers.<br></p>\r\n</div>\r\n<div class=\"custom-section custom-section-limitation\">\r\n<h2>Limitation</h2>\r\n<p>The limitation is a special condition that your game&nbsp;<em>must&nbsp;</em>follow, but is entirely&nbsp;open to interpretation. If you are unsure if your idea does or doesn&#x27;t fit the limitation,&nbsp; just remember that everyone will interpret&nbsp;it differently. If you believe in your interpretation, chances are, someone else will too.<br></p>\r\n<p>The limitation will be announced when the jam starts. You can vote for and suggest new limitations&nbsp;<a target=\"_blank\" href=\"https://minijamofficial.com/voting\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">here!</a></p>\r\n</div>\r\n<div class=\"custom-section custom-section-ratings\">\r\n<h2>Ratings</h2>\r\n<p>At the end of the Jam, there will be a rating period that lasts 5 days. Anyone who submits a game to the jam, as well as any team members added&nbsp;as contributors to your game&#x27;s project page can rate other games for the jam.&nbsp;Games will be&nbsp;rated on the following criteria:<br>\r\n</p>\r\n<ul>\r\n<li>\r\n<strong><del>Enjoyment</del></strong> - How much you enjoyed your time with the game.\r\n</li>\r\n<li>\r\n<strong><del>Concept&nbsp;</del></strong> - How interesting or unique the main focus of the game was.\r\n</li>\r\n<li>\r\n<strong><del>Presentation&nbsp;</del></strong> - How well executed the main focus of the game was.\r\n</li>\r\n<li>\r\n<strong><del>Use of limitation</del></strong> - How well the game incorporated the given limitation.\r\n</li>\r\n</ul>\r\n<p>Keep in mind that while the limitation is mandatory, the&nbsp;<em>theme&nbsp;</em>is purely for inspiration, and you should&nbsp;<em>not</em>&nbsp;rate a game differently based on how well the theme was incorporated.&nbsp;</p>\r\n</div>\r\n<div class=\"custom-section custom-section-rules\">\r\n<h2>Rules</h2>\r\n<ul class=\"custom-rules\">\r\n<li>\r\n<del>Read the rules</del>\r\n<p>Not reading the rules is not an excuse for breaking them.</p>\r\n</li>\r\n<li>\r\n<del>Follow the limitation</del>\r\n<p>It is mandatory that you incorporate the jam&#x27;s limitation into your game. This said, how you choose to interpret its meaning and go about incorporating it&nbsp;is entirely up to you.</p>\r\n</li>\r\n<li>\r\n<del>The game must be made for the jam</del>\r\n<p>You cannot submit previously made games to the jam. This jam is about creating something new in the given period of time.</p>\r\n</li>\r\n<li>\r\n<del>Keep game content safe</del><p>Any and all&nbsp;NSFW&nbsp;content, potentially offensive content, graphic content etc.&nbsp;<em>must&nbsp;</em>be clearly telegraphed with a content warning at the start of the game or&nbsp;in its description or cover.</p>\r\n</li>\r\n<li>\r\n<del>Your content only</del>\r\n<p>While asset packs and public domain material are allowed in submissions, you and your team must have the rights to&nbsp;<em>all </em>content in your game. This means that usage of&nbsp;the wide majority of available generative AI tools, such as those that generate images or sound is prohibited.</p></li></ul><ul class=\"custom-rules\">\r\n<li>\r\n<del>Answer submission questions honestly</del>\r\n<p>You will be prompted to answer a few questions when submitting your game. Please answer them to the best of your ability. Giving vague answers is a great way to set off red flags.</p></li></ul>\r\n<p>Any games that do not follow the rules&nbsp;<em>may be removed</em>&nbsp;from the jam without warning.</p></div>\r\n<div class=\"custom-section custom-section-faq\"><h2>FAQ</h2>\r\n<details>\r\n<p>There will be an announcement on the discord server, as well as a post in the community tab on the jam page&nbsp;explaining the steps you should take to submit your project late if you missed the set deadline.\r\n</p><summary> Help! I couldn&#x27;t submit on time, what do I do? </summary>\r\n</details>\r\n<details>\r\n<p>Mini Jam takes place every 2 weeks on a Thursday/Friday, depending on your time zone. You can expect the next Mini Jam to be up within a week of its start date.</p><summary> When does the next Mini Jam start, and when will it be announced?</summary>\r\n</details>\r\n<details>\r\n<p>The theme exists to inspire, following it is totally optional. However, following the limitation in some way&nbsp;is mandatory.</p><summary> Do I have to follow the theme?<br> </summary>\r\n</details>\r\n<details>\r\n<p>Almost certainly. You can interpret the limitation in any way you want. It will be up to you and your fellow jammers to determine if your interpretation is compelling.</p><summary>Is my idea&nbsp;a valid interpretation of the limitation?<br> </summary>\r\n</details>\r\n<details>\r\n<p>You can use any engine or framework you like. You can even make your own if you want.\r\n</p><summary> What engine can I use? </summary>\r\n</details>\r\n<details>\r\n<p>While video games are expected, this jam is open to any sort of game. You can build your game for any platform.\r\n</p><summary> What kind of game can I make? </summary>\r\n</details>\r\n<details>\r\n<p>Yes, you can make any changes to the project or project page during the rating period, just make sure that the original version of the game can still be downloaded if your project has a downloadable build and make a note on the game page describing what the changes in the post-jam version are.</p><summary> Can I make changes during the rating period?</summary>\r\n</details>\r\n<details>\r\n<p>As long as the game is mostly made within the jam timeframe, anything that wasn&#x27;t made specifically for this particular jam such as code from other projects or assets from asset packs&nbsp;are allowed, provided you have the legal rights to use them in your project.</p><summary> I have code or other assets from other projects I wish to use, are these allowed?</summary></details>\r\n<details>\r\n<p>Yes, but that is generally not advised. If you intend on working with multiple teams, please make sure each team is made aware and is okay with this.</p><summary> Can I submit more than one game? </summary>\r\n</details>\r\n<details>\r\n<p>Mini Jam is a strictly prize-less jam. The prizes are the games we&#x27;ve made along the way.\r\n</p><summary> Is there a prize for the winners? </summary>\r\n</details></div>\r\n<div class=\"custom-section custom-section-partners\">\r\n<h2>Partners</h2>\r\n<p>Participating in&nbsp;Ludum Dare? Be sure to join the official unofficial&nbsp;<a href=\"https://discord.gg/9DrcQmg\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Discord server</a>.\r\n</p>\r\n<p>Want a fun and easy way to make games? Try out&nbsp;<a href=\"https://ctjs.rocks/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Ct.Js</a>! It&#x27;s&nbsp;a free 2D game editor that aims to make programming fun and game development easy by its visual editors and well-documented code library. Available for Windows, Mac and Linux.</p>\r\n</div>\r\n<div class=\"custom-section custom-heart\"><br></div>\r\n<div class=\"custom_backing\"><br><br></div></div></div><script id=\"add_game_to_jam_lightbox_tpl\" type=\"text/template\"><div role=\"dialog\" tabIndex=\"-1\" id=\"add_game_to_jam_lightbox_8320665\" class=\"add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login has_fields lightbox\"><button class=\"close_button\"><svg stroke=\"currentColor\" stroke-linecap=\"round\" version=\"1.1\" role=\"img\" viewBox=\"0 0 24 24\" height=\"18\" class=\"svgicon icon_cross2\" aria-hidden fill=\"none\" width=\"18\" stroke-width=\"2\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target=\"_blank\" href=\"http://itch.io\">itch.io</a> to host entries. You&#039;ll need to register or log in on\n      itch.io in order to <span class=\"on_submit\">submit your game</span><span class=\"on_join\">join this jam</span>.</p><p class=\"on_submit\">After signing in you can create a new game on itch.io then\n      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action=\"jam_submit\" class=\"button\" href=\"/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fmini-jam-221-autumn\">Log in</a><span class=\"or_split\"> or </span><a data-register_action=\"jam_submit\" class=\"button\" href=\"/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fmini-jam-221-autumn\">Register</a></p></div></script></div></div><script id=\"loading_lightbox_tpl\" type=\"text/template\"><div aria-live=\"polite\" class=\"lightbox loading_lightbox\"><div class=\"loader_outer\"><div class=\"loader_label\">Loading</div><div class=\"loader_bar\"><div class=\"loader_bar_slider\"></div></div></div></div></script><script type=\"text/javascript\">new I.ViewJam('#view_jam_220188', {\"end_date\":\"2026-10-12 04:00:00\",\"start_date\":\"2026-10-09 04:00:00\",\"id\":420578,\"voting_end_date\":\"2026-10-16 04:00:00\"});init_JamLayoutHeader('#jam_layout_header_924696', {\"autocomplete_props\":{\"ca_source\":25,\"ca_types\":{\"jam\":4,\"featured_tag\":7,\"game\":1,\"browse_facet\":8,\"bundle\":6},\"autocomplete_url\":\"\\/autocomplete\",\"search_url\":\"\\/search\",\"i18n\":{\"search_placeholder\":\"Search for games, jams, tags or creators\",\"search\":\"Search\"}}});\nI.setup_page();</script></body></html>"}