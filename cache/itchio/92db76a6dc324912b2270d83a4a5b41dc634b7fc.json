_widget .stats_container{\n  margin-top: 462px;\n  position: absolute; \n  left: 0; \n  right: 0; \n  margin-left: auto;\n  margin-right: auto;\n}\n\n.jam_header_widget .stat_box{\n  margin:8px !important;\n}\n\n\n.jam_page_wrap {\n  background-attachment: fixed;\n  background-size: cover;\n}\n\nhr {\n  background-color: white;\n  height: 3px;\n  border-top: 2px solid whitesmoke;\n  border-left: 2px solid whitesmoke;\n  border-right: 2px solid whitesmoke;\n  border-bottom: 2px solid whitesmoke;\n  border-radius: 5px;\n}\n\n.jam_body {\n  border: 2px solid whitesmoke;\n}\n\n.custom-criterias {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  grid-template-rows: auto auto;\n}\n\n.custom-criterias-last-item {\n  grid-column: span 2;\n  justify-self: center;\n}\n\n.custom-prizes {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  grid-template-rows: auto auto;\n  perspective: 1000px;\n  overflow: hidden;\n}\n\n.custom-prizes-card-last-wrapper {\n  height: 300px;\n  grid-column: span 2;\n  justify-self: center;\n}\n\n.custom-prizes-card-wrapper {\n  height: 300px;\n}\n\n.custom-prizes-card {\n  width: 100%;\n  height: 100%;\n  position: relative;\n  transform-style: preserve-3d;\n  transition: transform 0.8s ease 0.05s;\n  display: grid;\n  will-change: transform;\n}\n\n.custom-prizes-card-wrapper:hover .custom-prizes-card{\n  transform: rotateY(180deg)\n}\n\n.custom-prizes-card-last-wrapper:hover .custom-prizes-card{\n  transform: rotateY(180deg)\n}\n\n.custom-prizes-front, .custom-prizes-back {\n  grid-area: 1 / 1;\n  backface-visibility: hidden;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.custom-prizes-front {\n  background-color: #000000;\n  overflow: hidden;\n}\n\n.custom-prizes-front img{\n  max-width: 300px;\n  height: auto;\n  object-fit: contain;\n  display: block;\n}\n\n.custom-prizes-back {\n  background-color: #000000;\n  color: white;\n  transform: rotateY(180deg);\n  text-align: center; \n}\n\n\n.custom-table{\n  margin-left: auto;\n  margin-right: auto;\n  width: 100%;\n}\n\n.custom-banner{\n  display: none;\n} </style></head><body class=\"locale_en jam_layout_widget layout_widget responsive no_theme_toggle\" data-host=\"itch.io\" data-page_name=\"view_jam\"><div id=\"jam_layout_header_4474817\" class=\"gray jam_layout_header_widget header_widget base_widget small_logo\"><a class=\"skip_to_main\" href=\"#maincontent\">Skip to main content</a><div class=\"primary_header\"><h1 title=\"itch.io - indie game hosting marketplace\" class=\"title\"><a title=\"itch.io - indie game hosting marketplace\" class=\"header_logo\" href=\"/\"><span class=\"visually_hidden\">itch.io</span><img src=\"https://static.itch.io/images/logo-black-new.svg\" class=\"full_logo\" width=\"775\" height=\"199\" alt=\"itch.io logo &amp; title\"/><img src=\"https://static.itch.io/images/itchio-textless-black.svg\" class=\"minimal_logo\" width=\"262\" height=\"235\" alt=\"itch.io logo\"/></a></h1><div class=\"header_buttons\"><a href=\"/games\" data-label=\"browse\" class=\"header_button browse_btn\">Browse Games</a><a href=\"/jams\" data-label=\"jams\" class=\"header_button jams_btn\">Game Jams</a><a href=\"/developers\" data-label=\"developers\" class=\"header_button developers_btn\"><span aria-hidden=\"true\" class=\"icon icon-upload\"></span>Upload Game</a><a href=\"/devlogs\" data-label=\"devlogs\" class=\"header_button devlogs_btn\">Developer Logs</a><a href=\"/community\" data-label=\"community.home\" class=\"header_button community.home_btn\">Community</a></div><form action=\"/search\" class=\"game_search\"><input name=\"q\" required=\"required\" class=\"search_input\" type=\"text\" placeholder=\"Search for games, jams, tags or creators\"/><button aria-label=\"Search\" class=\"submit_btn\"><svg stroke=\"currentColor\" stroke-linecap=\"round\" version=\"1.1\" role=\"img\" viewBox=\"0 0 24 24\" height=\"18\" class=\"svgicon icon_search\" aria-hidden fill=\"none\" width=\"18\" stroke-width=\"3\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg></button></form><div id=\"user_panel_6269016\" class=\"user_panel_widget base_widget\"><a href=\"/login\" data-register_action=\"header\" data-label=\"log_in\" class=\"panel_button\">Log in</a><a href=\"/register\" data-register_action=\"header\" data-label=\"register\" class=\"panel_button register_button\">Register</a></div></div><div class=\"header_dropdown\" data-target=\"browse\"><a href=\"/games/store\">Indie game store</a><a href=\"/games/free\">Free games</a><a href=\"/games/fun\">Fun games</a><a href=\"/games/tag-horror\">Horror games</a><div class=\"divider\"></div><a href=\"/tools\">Game development</a><a href=\"/game-assets\">Assets</a><a href=\"/comics\">Comics</a><div class=\"divider\"></div><a href=\"/sales\">Sales</a><a href=\"/bundles\">Bundles</a><div class=\"divider\"></div><a href=\"/jobs\">Jobs</a><div class=\"divider\"></div><a href=\"/tags\">Tags</a><a href=\"/game-development/engines\">Game Engines</a></div></div><div id=\"wrapper\" class=\"jam_page_wrap\"><div id=\"view_jam_5335524\" class=\"view_jam_page view_jam_base_page page_widget base_widget view_jam_default before_start\"><div class=\"jam_banner_outer\"><img class=\"jam_banner \"/></div><div class=\"jam_body\"><div id=\"jam_header_781325\" class=\"jam_header_widget base_widget\"><div class=\"header_inner\"><div class=\"header_columns\"><div class=\"title_colum\"><h1 class=\"jam_title_header\"><a href=\"/jam/metroidvania-month-34\">Metroidvania Month Finale</a></h1><div class=\"jam_host_header\">Hosted by <a href=\"https://falcon-nova.itch.io\">Falcon Nova</a> · <a href=\"https://bsky.app/hashtag/MetroidvaniaMonthJam\">#MetroidvaniaMonthJam</a></div></div><div class=\"stats_container\"><div class=\"stat_box\"><div class=\"stat_value\">162</div><div class=\"stat_label\">Joined</div></div></div></div><div class=\"header_tabs\"><a href=\"/jam/metroidvania-month-34\" data-label=\"tab_view_jam\" class=\"header_tab active\">Overview</a><div class=\"tab_group\"><a href=\"/jam/metroidvania-month-34/community\" class=\"header_tab\">Community</a><span class=\"community_activity\">6</span></div></div></div></div><div class=\"submitter_outer\"><div id=\"jam_submitter_7916896\" class=\"jam_submitter_widget base_widget before_start\"><div class=\"date_data\">Submissions open from <span class=\"date_format\" data-format=\"MMMM Do YYYY [at] h:mm A\">2026-11-16 03:00:00</span> to <span class=\"date_format\" data-format=\"MMMM Do YYYY [at] h:mm A\">2026-12-16 03:00:00</span></div><div class=\"countdown\"><span class=\"countdown_label\">Starts in</span><div class=\"times\"><div data-name=\"years\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">years</div></div><div data-name=\"months\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">months</div></div><div data-name=\"days\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">days</div></div><div data-name=\"hours\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">hours</div></div><div data-name=\"minutes\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">minutes</div></div><div data-name=\"seconds\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">seconds</div></div></div></div><div class=\"state_action\"><button data-method=\"post\" class=\"button fat submitter_button join_jam_btn\" data-href=\"/jam/418001/join\">Join jam</button></div></div></div><div class=\"jam_content user_formatted\"><h1 class=\"text-center\"><img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\">&nbsp;Game devs!&nbsp;<img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\"></h1>\r\n<h3 class=\"text-center\">I really like&nbsp;<a href=\"https://en.wikipedia.org/wiki/Metroidvania\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Metroidvania</a> games. I used to think it was hard to find good ones. Over the last 8 years, so many game developers proved the opposite. In this ultimate edition,&nbsp;I invite you to join the trend of making a metroidvania game!</h3>\r\n<p class=\"text-center\"><br></p>\r\n<hr>\r\n<p class=\"text-center\"><br></p>\r\n<h1 class=\"text-center\"><img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\">&nbsp;Rules&nbsp;<img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\"></h1>\r\n<h3 class=\"text-center\">Rules and details&nbsp;will be revealed soon!</h3>\r\n<p class=\"text-center\"><br></p>\r\n<hr>\r\n<p class=\"text-center\"><br></p>\r\n<h1 class=\"text-center\"><strong><img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\">&nbsp;Community&nbsp;<img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\"></strong></h1>\r\n<h2 class=\"text-center\"></h2>\r\n<h3 class=\"text-center\">Special thanks to <a target=\"_blank\" href=\"https://zahranworrell.itch.io/\">Zahran Worrell</a> for the design help.</h3>\r\n<h3 class=\"text-center\">Don&#x27;t know how to get started? Check out this <a target=\"_blank\" href=\"https://itch.io/blog/490276/so-you-want-to-make-an-metroidvania-month-entry\">this guide</a>.</h3>\r\n<h3 class=\"text-center\">The <a href=\"https://discord.gg/metroidvania-month-jam-468048103212187658\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Discord server</a> is the all-in-one central for the competition and multimedia creativity in general. You should check it out.</h3>\r\n<h3 class=\"text-center\">Are you a musician ? Check out our in-house <a href=\"https://www.youtube.com/@PixelNotesFestival\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">virtual music festival</a>.</h3>\r\n<h3 class=\"text-center\"><a target=\"_blank\" href=\"https://itch.io/jam/metroidvania-month-33\">Previous jam</a></h3>\r\n<p class=\"text-center\"><img class=\"custom-banner\" src=\"https://img.itch.zone/aW1nLzI4MjMxMzAxLnBuZw==/original/QY2qu6.png\" loading=\"lazy\"><br></p>\r\n<p class=\"text-center\"><br></p>\r\n<hr>\r\n<p class=\"text-center\"><br></p>\r\n<h1 class=\"text-center\"><strong><img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\">&nbsp;Partners&nbsp;<img src=\"https://img.itch.zone/aW1nLzIzMTUwMTc2LnBuZw==/original/%2BlsBsq.png\" loading=\"lazy\"></strong></h1>\r\n<h3 class=\"text-center\">Thanks to our partners that contributed in making the Metroidvania Month Jam experience more interesting and exciting for game developers over the different editions!</h3>\r\n<div class=\"custom-prizes\">\r\n<div class=\"custom-prizes-card-wrapper\">\r\n<div class=\"custom-prizes-card\">\r\n<div class=\"custom-prizes-front\"><h2 class=\"text-center\"><img class=\"custom-prize-pic\" src=\"https://img.itch.zone/aW1hZ2UyL2phbS8zMTM1MjUvNzE2MjgwOC5wbmc=/original/3BKIcU.png\" loading=\"lazy\"></h2></div>\r\n<div class=\"custom-prizes-back\"><h3 class=\"text-center custom-prizes-content\"><a href=\"https://itch.io/jam/bored-pixels-jam-9\">Bored Pixels Jam</a>.</h3></div>\r\n</div></div>\r\n<div class=\"custom-prizes-card-wrapper\">\r\n<div class=\"custom-prizes-card\">\r\n<div class=\"custom-prizes-front\"><h2 class=\"text-center\"><img class=\"custom-prize-pic\" src=\"https://img.itch.zone/aW1nLzg5NjU1MzgucG5n/original/QRk%2Fh9.png\" loading=\"lazy\"></h2></div>\r\n<div class=\"custom-prizes-back\"><h3 class=\"text-center custom-prizes-content\"><a href=\"https://jasontomlee.itch.io/\">LearnIndie</a>.</h3></div>\r\n</div></div>\r\n<div class=\"custom-prizes-card-wrapper\">\r\n<div class=\"custom-prizes-card\">\r\n<div class=\"custom-prizes-front\"><h2 class=\"text-center\"><img class=\"custom-prize-pic\" src=\"https://img.itch.zone/aW1nLzExMzU0MzQ2LnBuZw==/original/YI67og.png\" loading=\"lazy\"></h2></div>\r\n<div class=\"custom-prizes-back\"><h3 class=\"text-center custom-prizes-content\"><a href=\"http://plusmusic.ai/\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">PlusMusic</a>.</h3></div>\r\n</div></div>\r\n<div class=\"custom-prizes-card-wrapper\">\r\n<div class=\"custom-prizes-card\">\r\n<div class=\"custom-prizes-front\"><h2 class=\"text-center\"><img src=\"https://img.itch.zone/aW1nLzE4MjE2Njg1LnBuZw==/original/gujZXN.png\" class=\"custom-prize-pic\" loading=\"lazy\"></h2></div>\r\n<div class=\"custom-prizes-back\"><h3 class=\"text-center custom-prizes-content\"><a href=\"https://www.anchorpoint.app\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Anchorpoint</a>.</h3></div>\r\n</div></div>\r\n<div class=\"custom-prizes-card-wrapper\">\r\n<div class=\"custom-prizes-card\">\r\n<div class=\"custom-prizes-front\"><h2 class=\"text-center\"><img src=\"https://img.itch.zone/aW1nLzIzNDM4MzgyLnBuZw==/original/Hb2TMV.png\" class=\"custom-prize-pic\" loading=\"lazy\"></h2></div>\r\n<div class=\"custom-prizes-back\"><h3 class=\"text-center custom-prizes-content\"><a href=\"https://rittzler.itch.io/pseudoregalia\">Pseudoregalia</a>.</h3></div>\r\n</div></div>\r\n<div class=\"custom-prizes-card-wrapper\">\r\n<div class=\"custom-prizes-card\">\r\n<div class=\"custom-prizes-front\"><h2 class=\"text-center\"><img class=\"custom-prize-pic\" src=\"https://img.itch.zone/aW1nLzIzNjE5ODM4LnBuZw==/original/ZB0bmy.png\" loading=\"lazy\"></h2></div>\r\n<div class=\"custom-prizes-back\"><h3 class=\"text-center custom-prizes-content\"><a href=\"https://craftpix.net/?utm_source=itch.io&utm_medium=gamejam&utm_campaign=metroidvania-month\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">CraftPix</a>.</h3></div>\r\n</div></div>\r\n</div>\r\n<p class=\"text-center\"><br></p>\r\n<hr>\r\n<p class=\"text-center\"><br></p>\r\n<h1 class=\"text-center\"><strong><img src=\"https://