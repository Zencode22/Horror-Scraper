rketplace\"><span class=\"visually_hidden\">itch.io</span><img width=\"775\" src=\"https://static.itch.io/images/logo-black-new.svg\" height=\"199\" alt=\"itch.io logo &amp; title\" class=\"full_logo\"/><img width=\"262\" src=\"https://static.itch.io/images/itchio-textless-black.svg\" height=\"235\" alt=\"itch.io logo\" class=\"minimal_logo\"/></a></h1><div class=\"header_buttons\"><a data-label=\"browse\" href=\"/games\" class=\"header_button browse_btn\">Browse Games</a><a data-label=\"jams\" href=\"/jams\" class=\"header_button jams_btn\">Game Jams</a><a data-label=\"developers\" href=\"/developers\" class=\"header_button developers_btn\"><span aria-hidden=\"true\" class=\"icon icon-upload\"></span>Upload Game</a><a data-label=\"devlogs\" href=\"/devlogs\" class=\"header_button devlogs_btn\">Developer Logs</a><a data-label=\"community.home\" href=\"/community\" class=\"header_button community.home_btn\">Community</a></div><form class=\"game_search\" action=\"/search\"><input name=\"q\" placeholder=\"Search for games, jams, tags or creators\" required=\"required\" type=\"text\" class=\"search_input\"/><button aria-label=\"Search\" class=\"submit_btn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" class=\"svgicon icon_search\" width=\"18\" stroke-linejoin=\"round\" version=\"1.1\" aria-hidden stroke=\"currentColor\" stroke-linecap=\"round\" role=\"img\" height=\"18\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg></button></form><div id=\"user_panel_7261016\" class=\"user_panel_widget base_widget\"><a data-label=\"log_in\" data-register_action=\"header\" href=\"/login\" class=\"panel_button\">Log in</a><a data-label=\"register\" data-register_action=\"header\" href=\"/register\" class=\"panel_button register_button\">Register</a></div></div><div data-target=\"browse\" class=\"header_dropdown\"><a href=\"/games/store\">Indie game store</a><a href=\"/games/free\">Free games</a><a href=\"/games/fun\">Fun games</a><a href=\"/games/tag-horror\">Horror games</a><div class=\"divider\"></div><a href=\"/tools\">Game development</a><a href=\"/game-assets\">Assets</a><a href=\"/comics\">Comics</a><div class=\"divider\"></div><a href=\"/sales\">Sales</a><a href=\"/bundles\">Bundles</a><div class=\"divider\"></div><a href=\"/jobs\">Jobs</a><div class=\"divider\"></div><a href=\"/tags\">Tags</a><a href=\"/game-development/engines\">Game Engines</a></div></div><div id=\"wrapper\" class=\"jam_page_wrap\"><div id=\"view_jam_7898522\" class=\"view_jam_page view_jam_base_page page_widget base_widget view_jam_default before_start has_banner\"><div class=\"jam_banner_outer\"><img src=\"https://img.itch.zone/aW1nLzI4OTYyODA0LnBuZw==/original/CJTrdA.png\" class=\"jam_banner \"/></div><div class=\"jam_body\"><div id=\"jam_header_8615857\" class=\"jam_header_widget base_widget\"><div class=\"header_inner\"><div class=\"header_columns\"><div class=\"title_colum\"><h1 class=\"jam_title_header\"><a href=\"/jam/lve-jam-2026-b-side\">LÖVE Jam 2026 [B-SIDE]</a></h1><div class=\"jam_host_header\">Hosted by <a href=\"https://keyslam.itch.io\">Keyslam</a>, <a href=\"https://pablomayobre.itch.io\">Pablo Mayobre</a> · <a href=\"https://bsky.app/hashtag/lovejam2026bside\">#lovejam2026bside</a></div></div><div class=\"stats_container\"><div class=\"stat_box\"><div class=\"stat_value\">60</div><div class=\"stat_label\">Joined</div></div></div></div><div class=\"header_tabs\"><a data-label=\"tab_view_jam\" href=\"/jam/lve-jam-2026-b-side\" class=\"header_tab active\">Overview</a><div class=\"tab_group\"><a href=\"/jam/lve-jam-2026-b-side/community\" class=\"header_tab\">Community</a><span class=\"community_activity\">1</span></div></div></div></div><div class=\"submitter_outer\"><div id=\"jam_submitter_2453143\" class=\"jam_submitter_widget base_widget before_start\"><div class=\"date_data\">Submissions open from <span class=\"date_format\" data-format=\"MMMM Do YYYY [at] h:mm A\">2026-11-06 10:00:00</span> to <span class=\"date_format\" data-format=\"MMMM Do YYYY [at] h:mm A\">2026-11-16 10:00:00</span></div><div class=\"countdown\"><span class=\"countdown_label\">Starts in</span><div class=\"times\"><div data-name=\"years\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">years</div></div><div data-name=\"months\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">months</div></div><div data-name=\"days\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">days</div></div><div data-name=\"hours\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">hours</div></div><div data-name=\"minutes\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">minutes</div></div><div data-name=\"seconds\" class=\"time_block\"><div class=\"block_value\"></div><div class=\"block_label\">seconds</div></div></div></div><div class=\"state_action\"><button data-href=\"/jam/418796/join\" data-method=\"post\" class=\"button fat submitter_button join_jam_btn\">Join jam</button></div></div></div><div class=\"jam_content user_formatted\"><h2>Welcome</h2>\r\n<p><strong>TL;DR: LÖVE Jam is an&nbsp;awesome&nbsp;gamejam where you make a game using&nbsp;<a href=\"https://love2d.org/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">LÖVE</a>!\r\n</strong></p>\r\n<p>LÖVE is an amazing, free, open source game framework, with a lovely community full of nice and very creative people.</p>\r\n<p>This jam exists to celebrate everyone making LÖVE and its amazing community possible. This event is intended to spark creativity and a learning opportunity for everyone participating, and we hope this can result in&nbsp;more games and more adoption of this lovely framework, please enjoy and have fun!</p>\r\n<figure><a href=\"https://love2d.org/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\"><img src=\"https://img.itch.zone/aW1nLzI1MTA2MTA0LnBuZw==/original/iW%2Bq40.png\" alt=\"Get LÖVE, it's a game framework\" loading=\"lazy\"></a>\r\n</figure>\r\n<h2>Rules</h2>\r\n<ul><li><strong>Your game MUST be made with the LÖVE framework.<br></strong>Your game must work with an official version of LÖVE (nightlies are allowed).<br>Ports of LÖVE,&nbsp;frameworks based on LÖVE, or any other engine/framework are NOT allowed. <br>You can upload additional builds using ports as long as there is a version that can run with an official LÖVE version.</li><li><strong>NSFW / mature / sensitive content MUST be properly disclosed.<br></strong>If your game features such content there should be a&nbsp;warning in the description and/or when the game first loads up.<br>There may be minors playing your game so please be mindful.<br>\r\n</li><li><strong>AI usage is NOT allowed.<br></strong>AI usage goes against the spirit of the jam. The reasons include copyright infringement and plagiarism over training data and environmental impact of this technology.</li><li><strong>The game MUST be&nbsp;made during the jam.<br></strong>You may use basecode and libraries made before the jam.<br>Games made before the jam&nbsp;<u>are not</u>&nbsp;basecode, and go against the spirit of the jam.\r\n</li><li><strong>Images, music, and other assets SHOULD be made during the jam.<br></strong><u>Any asset made (by you or someone else)&nbsp;before the jam period is considered a pre-made asset.<br>If you use pre-made assets, you</u>&nbsp;<u>MUST include a list, giving credit to their author (including those made by you)</u>.<br>If you can&#x27;t make assets yourself team up with an artist and/or a musician.<br>Voters SHOULD favor games that feature assets made during the jam over those that don&#x27;t.</li><li><strong>You may work alone or as a team. Find teammates in our&nbsp;<a href=\"https://discord.gg/hgCPmjNgwQ\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Discord</a>!<br></strong>There is no restriction team size, but larger teams are harder to organize, so 2/4 works best.\r\n</li><li><strong>The jam runs for 10 days, you may use as much time as you need.<br></strong>The long duration of the jam is to allow more people to participate, if you want a tighter time constraint you can use just one weekend.<br>Some games have been made in under 8 hours, so don’t feel discouraged if you can’t spend much time.</li><li><strong>Do it for the fun and the experience.<br></strong>Even though the jam is rated, the most important thing is to enjoy the challenge.</li></ul>\r\n<h2>Theme</h2>\r\n<p>The theme will be revealed when the jam starts!</p>\r\n<p>The theme for this jam is <strong>optional</strong>, it&nbsp;exists to spark ideas and creativity. If you don&#x27;t like it, we still hope you join the jam without including the theme as part of your game.</p>\r\n<h2>Tips</h2>\r\n<ul><li>Check out these&nbsp;<strong>amazing</strong>&nbsp;<a href=\"https://github.com/love2d-community/awesome-love2d\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">libraries and tools</a>&nbsp;to speed up your game development!\r\n</li><li>There is the&nbsp;<a href=\"https://love2d.org/wiki/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">wiki</a>&nbsp;and some&nbsp;<strong>great</strong>&nbsp;<a href=\"https://github.com/love2d-community/awesome-love2d#tutorials\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">tutorials</a>&nbsp;out there that teach you how to use LÖVE!\r\n</li><li>Join the&nbsp;<strong>fabulous</strong>&nbsp;<a href=\"https://discord.gg/hgCPmjNgwQ\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">Discord</a>&nbsp;to chat with other Lovers! Or discuss with them in the&nbsp;<a href=\"https://love2d.org/forums/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">forum</a>&nbsp;and&nbsp;<a href=\"https://www.reddit.com/r/love2d/\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">subreddit</a>\r\n</li><li>You can&nbsp;<strong>share your progress</strong>&nbsp;in X or Bluesky using the&nbsp;<a href=\"https://x.com/hashtag/lovejam2026\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">#lovejam2026</a>&nbsp;(<a href=\"https://bsky.app/hashtag/lovejam2026\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">bsky</a>)&nbsp;hashtag!\r\n</li><li><strong>Follow us</strong>&nbsp;at&nbsp;<a href=\"https://x.com/obey_love\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">@obey_love</a>&nbsp;and <a href=\"https://bsky.app/profile/love-framework.bsky.social\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">@love-framework.bsky.social</a> to find out other&nbsp;<strong>cool</strong>&nbsp;projects.\r\n</li><li><strong>Check</strong>&nbsp;past jams from&nbsp;<a href=\"https://www.love2d.org/forums/viewtopic.php?p=127601\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">2013</a>,&nbsp;<a href=\"https://www.love2d.org/forums/viewtopic.php?p=172437\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\">2014</a>&nbsp;(<a href=\"https://itch.io/jam/love-jam-2\" target=\"_blank\">itch.io</a>),&nbsp;<a href=\"https://itch.io/jam/love2d-jam\" target=\"_blank\">2017</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2018\" target=\"_blank\">2018</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2019\" target=\"_blank\">2019</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2020\" target=\"_blank\">2020</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2021\" target=\"_blank\">2021</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2022\" target=\"_blank\">2022</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2023\" target=\"_blank\">2023</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2024\" target=\"_blank\">2024</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2025\" target=\"_blank\">2025</a>,&nbsp;<a href=\"https://itch.io/jam/love2d-jam-2025b\" target=\"_blank\">2025 - B-Side</a>, <a href=\"https://itch.io/jam/love2d-jam-2026\">2026</a></li></ul>\r\n<figure><a href=\"https://discord.gg/hgCPmjNgwQ\" target=\"_blank\" rel=\"nofollow noopener\" referrerpolicy=\"origin\"><img alt=\"Join us on Discord\" src=\"https://img.itch.zone/aW1nLzI1MDgxNzM4LnBuZw==/original/vLylLq.png\" loading=\"lazy\"></a></figure></div></div><script id=\"add_game_to_jam_lightbox_tpl\" type=\"text/template\"><div role=\"dialog\" tabIndex=\"-1\" id=\"add_game_to_jam_lightbox_3716530\" class=\"add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login has_fields lightbox\"><button class=\"close_button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" class=\"svgicon icon_cross2\" width=\"18\" stroke-linejoin=\"round\" version=\"1.1\" aria-hidden stroke=\"currentColor\" stroke-linecap=\"round\" role=\"img\" height=\"18\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target=\"_blank\" href=\"http://itch.io\">itch.io</a> to host entries. You&#039;ll need to register or log in on\n      itch.io in order to <span class=\"on_submit\">submit your game</span><span class=\"on_join\">join this jam</span>.</p><p class=\"on_submit\">After signing in you can create a new game on itch.io then\n      return here and click the <em>submit game</em> button again to enter your game.</p><p><a href=\"/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Flve-jam-2026-b-side\" data-register_action=\"jam_submit\" class=\"button\">Log in</a><span class=\"or_split\"> or </span><a href=\"/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Flve-jam-2026-b-side\" data-register_action=\"jam_submit\" class=\"button\">Register</a></p></div></script></div></div><script id=\"loading_lightbox_tpl\" type=\"text/template\"><div aria-live=\"polite\" class=\"lightbox loading_lightbox\"><div class=\"loader_outer\"><div class=\"loader_label\">Loading</div><div class=\"loader_bar\"><div class=\"loader_bar_slider\"></div></div></div></div></script><script type=\"text/javascript\">new I.ViewJam('#view_jam_7898522', {\"voting_end_date\":\"2026-11-23 10:00:00\",\"end_date\":\"2026-11-16 10:00:00\",\"id\":418796,\"start_date\":\"2026-11-06 10:00:00\"});init_JamLayoutHeader('#jam_layout_header_1927675', {\"autocomplete_props\":{\"ca_source\":25,\"ca_types\":{\"featured_tag\":7,\"browse_facet\":8,\"bundle\":6,\"jam\":4,\"game\":1},\"autocomplete_url\":\"\\/autocomplete\",\"search_url\":\"\\/search\",\"i18n\":{\"search\":\"Search\",\"search_placeholder\":\"Search for games, jams, tags or creators\"}}});\nI.setup_page();</script></body></html>"}