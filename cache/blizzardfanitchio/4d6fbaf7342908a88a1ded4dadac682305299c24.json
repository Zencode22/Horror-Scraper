=\"round\" width=\"18\" version=\"1.1\" stroke-width=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" role=\"img\"><circle cx=\"12\" cy=\"8\" r=\"7\"></circle><polyline points=\"8.21 13.89 7 23 12 20 17 23 15.79 13.88\"></polyline></svg>Submission to Brackeys Game Jam 2026.2</a></li><li><a data-label=\"related_btn\" href=\"https://itch.io/games-like/4951683/give-me-your-hand\" target=\"_blank\" class=\"action_btn related_games_btn\"><svg height=\"18\" viewBox=\"0 0 24 24\" aria-hidden class=\"svgicon icon_map\" stroke-linejoin=\"round\" width=\"18\" version=\"1.1\" stroke-width=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" role=\"img\"><polygon points=\"1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6\"></polygon><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"18\"></line><line x1=\"16\" y1=\"6\" x2=\"16\" y2=\"22\"></line></svg> <span class=\"full_label\">Related games</span><span class=\"mobile_label\">Related</span></a></li></ul><script type=\"text/javascript\">new I.GameUserTools('#user_tools')</script><div id=\"wrapper\" class=\"main wrapper game_page_wrapper\"><div id=\"inner_column\" class=\"inner_column size_large family_lato\"><div id=\"header\" class=\"header\"><h1 itemprop=\"name\" class=\"game_title\">Give Me Your Hand</h1></div><div id=\"view_html_game_6036164\" class=\"view_html_game_page view_game_page page_widget base_widget ready\"><div id=\"html_embed_7079520\" class=\"html_embed_widget base_widget embed_wrapper\"><div data-width=\"1280\" data-height=\"720\" style=\"width: 1280px; height: 720px\" class=\"game_frame game_loaded\"><button title=\"Enter fullscreen\" class=\"fullscreen_btn\"><img src=\"https://itch.io/static/images/enlarge.svg?1791312061\"/></button><iframe allowtransparency=\"true\" webkitallowfullscreen=\"true\" mozallowfullscreen=\"true\" msallowfullscreen=\"true\" frameborder=\"0\" allowfullscreen=\"true\" scrolling=\"no\" src=\"https://html-classic.itch.zone/html/19015261/index.html?v=1788047857\" id=\"game_drop\" allow=\"autoplay; fullscreen *; geolocation; microphone; camera; midi; monetization; xr-spatial-tracking; gamepad; gyroscope; accelerometer; xr; cross-origin-isolated; web-share\"></iframe></div></div><div class=\"columns\"><div class=\"left_col column\"><div class=\"formatted_description user_formatted\"><p><strong>Give Me Your Hand</strong> is a single-player card survival strategy game made for Brackeys Game Jam 2026.2.</p>\r\n<p>Every day, three strangers offer you cards&mdash;and any of them may be lying. Peel back the corner of a card, inspect the limited information, and judge their stories. Take the card, discard it, or&mdash;once you are armed&mdash;shoot the liar.</p>\r\n<p>Build and sell poker hands to earn cash, then pay the ever-rising rent before the day ends. At night, visit the skeletal merchant to unlock new poker hands, expand your capacity, and purchase a double-barrel shotgun and shells.</p>\r\n<p>Survive all 30 days to earn your freedom.</p>\r\n<p><strong>HOW TO PLAY</strong></p>\r\n<p>• Hover over the bottom-left corner of a card to peek at it.</p>\r\n<p>• Drag a card downward to take it.</p>\r\n<p>• Drag it to the left to discard it.</p>\r\n<p>• Select cards in your hand to build and sell poker combinations.</p>\r\n<p>• Pay the rent before ending each day.</p>\r\n<p>• Use the night shop to prepare for the days ahead.</p>\r\n<p><strong>CREDITS</strong></p>\r\n<p>Art:&nbsp;<a href=\"https://www.pngsucai.com/\" referrerpolicy=\"origin\" rel=\"nofollow noopener\">PNG素材网</a><br></p>\r\n<p>Music: “Walking Along” by Kevin MacLeod</p>\r\n<p>Licensed under CC BY 4.0</p>\r\n<p><a href=\"https://incompetech.com/music/royalty-free/index.html?isrc=USUAN1100020\" referrerpolicy=\"origin\" rel=\"nofollow noopener\">https://incompetech.com/music/royalty-free/index.html?isrc=USUAN1100020</a></p>\r\n<p>SFX:&nbsp;&nbsp;<a href=\"https://gfxsounds.com/\" referrerpolicy=\"origin\" rel=\"nofollow noopener\">GFX Sounds</a></p></div><div class=\"more_info